{
  "name": "thesis",
  "version": "1.0.0",
  "description": "Modular PERN Stack Thesis Project",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "m": "cd backend/metrobank-service && nodemon server.js",
    "r": "cd backend/registrar-service && nodemon server.js",
    "s": "cd backend/student-service && nodemon server.js",
    "frontend": "cd frontend && npm run dev",
    "backend": "concurrently \"npm run m\" \"npm run r\" \"npm run s\"",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\""
  },
  "keywords": [
    "pern",
    "thesis",
    "microservices",
    "modular"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@arcjet/node": "^1.0.0-beta.3",
    "@tailwindcss/vite": "^4.1.4",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.14.1",
    "thesis": "file:"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
